METADATA

title: Sales Data Access Policy

description: Merges GSCM and DSP permissions to compute allowed columns and row filters per table.

authors:

- agent-generator

custom:

domain: access-policy

package gaia.gaia00003.rdb

default result := {
"user_id": "user_id",
"decision": "deny",
"matched_pms": [],
"tables": {}
}

result :=
"user_id": object.get(input, "user_id", "user_id"),
"decision": "allow",
"matched_pms": matched_pms,
"tables": {scope1: {
"all_columns": all_columns(scope1),
"allowed_columns": step2_allowed(scope1),
"row_filter": final_filter(scope1)
}
some scope1 in gscm_table_set
table_exists(scope1)

} if {
count(matched_pms) > 0
} else := {
"user_id": object.get(input, "user_id", "user_id"),
"decision": "deny",
"matched_pms": [],
"tables": {}
}

any_gscm_matched if {
some pm in object.get(input, "legacy_pms", [])
some p in data.permissions
p.permission_grp_concat == pm
startswith(pm, "GSCM__")
}

all_matched_pms := [pm |
some pm in object.get(input, "legacy_pms", [])
some p in data.permissions
p.permission_grp_concat == pm
]

result_table_scopes := scope1
some scope1 in gscm_table_set
table_exists(scope1)

pm_maps_to_result_table§ if {
some s in p.sources
s.scope_1 in result_table_scopes
}

matched_pms := [pm |
some pm in all_matched_pms
some p in data.permissions
p.permission_grp_concat == pm
pm_maps_to_result_table§
] if {
any_gscm_matched
}

gscm_table_set := s.scope_1
some p in data.permissions
p.permission_grp_concat in object.get(input, "legacy_pms", [])
startswith(p.permission_grp_concat, "GSCM__")
some s in p.sources

sales_tables := s.scope_1
some p in data.permissions
startswith(p.permission_grp_concat, "GSCM_MONITOR__MSP$")
some s in p.sources

rule4_tables := s.scope_1
some p in data.permissions
startswith(p.permission_grp_concat, "GSCM_MONITOR__")
some s in p.sources

step1_has_star(scope1) if {
some p in data.permissions
p.permission_grp_concat in object.get(input, "legacy_pms", [])
startswith(p.permission_grp_concat, "GSCM__")
some s in p.sources
s.scope_1 == scope1
"*" in s.scope_2
}

step1_allowed(scope1) := [f |
some p in data.permissions
p.permission_grp_concat in object.get(input, "legacy_pms", [])
startswith(p.permission_grp_concat, "GSCM__")
some s in p.sources
s.scope_1 == scope1
some f in s.scope_2
f != "*"
] if {
not step1_has_star(scope1)
}

step1_allowed(scope1) := [f |
some s in data.all_sources
s.scope_1 == scope1
some f in s.scope_2
f != "*"
] if {
step1_has_star(scope1)
}

all_sources_fields(scope1) := [f |
some s in data.all_sources
s.scope_1 == scope1
some f in s.scope_2
f != "*"
]

step1_allowed_set(scope1) := f some f in step1_allowed(scope1)

all_columns(scope1) := array.concat(step1_allowed(scope1), [f |
some f in all_sources_fields(scope1)
not f in step1_allowed_set(scope1)
])

dsp_amt_present(scope1) if {
some p in data.permissions
p.permission_grp_concat in object.get(input, "legacy_pms", [])
startswith(p.permission_grp_concat, "GSCM_MONITOR__")
some s in p.sources
s.scope_1 == scope1
"AMT" in s.scope_2
}

step2_allowed(scope1) := l if {
l := step1_allowed(scope1)
"AMT" in l
}

step2_allowed(scope1) := array.concat(l, ["AMT"]) if {
l := step1_allowed(scope1)
not "AMT" in l
dsp_amt_present(scope1)
}

step2_allowed(scope1) := l if {
l := step1_allowed(scope1)
not "AMT" in l
not dsp_amt_present(scope1)
}

step2_raw_filters(scope1) := [s.filter |
some p in data.permissions
p.permission_grp_concat in object.get(input, "legacy_pms", [])
startswith(p.permission_grp_concat, "GSCM_MONITOR__")
some s in p.sources
s.scope_1 == scope1
]

rawdata_present if {
some pm in all_matched_pms
indexof(pm, "SOM$RawData[SOM]") >= 0
}

has_region_id(scope1) if {
some f in step2_raw_filters(scope1)
startswith(f, "(REGION_ID")
}

som_button_tables := s.scope_1
some p in data.permissions
contains(p.permission_grp_concat, "SOM$RawData[SOM]")
some s in p.sources

table_exists(scope1) if {
scope1 in gscm_table_set
not scope1 in som_button_tables
not scope1 in sales_tables
}

table_exists(scope1) if {
scope1 in gscm_table_set
scope1 in som_button_tables
rawdata_present
}

table_exists(scope1) if {
scope1 in gscm_table_set
scope1 in sales_tables
has_region_id(scope1)
}

has_region_id_in(scope1) if {
some f in step2_raw_filters(scope1)
startswith(f, "(REGION_ID IN")
}

step3_filters(scope1) := [f |
some f in step2_raw_filters(scope1)
not startswith(f, "(REGION_ID")
] if {
scope1 in sales_tables
has_region_id_in(scope1)
}

step3_filters(scope1) := step2_raw_filters(scope1) if {
scope1 in sales_tables
not has_region_id_in(scope1)
}

step3_filters(scope1) := step2_raw_filters(scope1) if {
not scope1 in sales_tables
}

hb00_present(scope1) if {
some f in step3_filters(scope1)
f == "(APP_LVL_1_NM = 'HBM')"
}

non_empty_filters(scope1) := [f |
some f in step3_filters(scope1)
f != ""
f != "(APP_LVL_1_NM = 'HBM')"
]

or_string(scope1) := concat(" OR ", non_empty_filters(scope1))

final_filter(scope1) := "" if {
scope1 in rule4_tables
hb00_present(scope1)
count(non_empty_filters(scope1)) == 0
}

final_filter(scope1) := sprintf("(%s)", [ors]) if {
scope1 in rule4_tables
hb00_present(scope1)
count(non_empty_filters(scope1)) > 0
ors := or_string(scope1)
}

final_filter(scope1) := "(APP_LVL_1_NM != 'HBM')" if {
scope1 in rule4_tables
not hb00_present(scope1)
count(non_empty_filters(scope1)) == 0
}

final_filter(scope1) := sprintf("((%s) AND (APP_LVL_1_NM != 'HBM'))", [ors]) if {
scope1 in rule4_tables
not hb00_present(scope1)
count(non_empty_filters(scope1)) > 0
ors := or_string(scope1)
}

non_empty_step3(scope1) := [f | some f in step3_filters(scope1); f != ""]

final_filter(scope1) := "" if {
not scope1 in rule4_tables
count(non_empty_step3(scope1)) == 0
}

final_filter(scope1) := s if {
not scope1 in rule4_tables
count(non_empty_step3(scope1)) > 0
s := concat(" OR ", non_empty_step3(scope1))
}
