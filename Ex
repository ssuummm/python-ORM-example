def _secured_subquery_sql(
    table: exp.Table,
    source_text: str,
    tp: TablePolicy,
    banned_referenced: Set[str],
) -> str:
    banned_needed = {c.upper() for c in banned_referenced}
    projections: List[str] = []
    for col in tp.all_columns:
        if tp.is_allowed(col):
            projections.append(col)
        elif col.upper() in banned_needed:
            projections.append(f"NULL AS {col}")

    if not projections:
        # allowed_columns == [] (fully denied) 이면서 outer 가 이 테이블을
        # 이름 있는 컬럼 참조 없이 (예: bare `SELECT *`) 접근한 경우.
        # projections 가 비면 `SELECT FROM t` 형태의 문법 오류가 되므로,
        # all_columns 전체를 NULL AS 로 채워 유효한 SQL을 보장한다.
        projections = [f"NULL AS {col}" for col in tp.all_columns]

    inner = f"(SELECT {', '.join(projections)} FROM {source_text}"
    if tp.row_filter:
        inner += f" WHERE {tp.row_filter}"
    inner += ")"

    if table.args.get("alias") is None:
        inner += f" {table.name}"
    return inner

def _build_column_deny_message(body, referenced: set[str]) -> str:
    """allowed_columns=['*'] 가 아닌, 이번 SQL 이 실제 참조한 테이블의 차단 컬럼을 테이블별로 안내."""
    parts: list[str] = []
    for table_name, tp in body.policy.get("tables", {}).items():
        if table_name.upper() not in referenced:
            continue
        allowed = tp.get("allowed_columns", [])
        if allowed == ["*"]:
            continue
        all_cols = tp.get("all_columns", [])
        denied_cols = sorted(set(all_cols) - set(allowed))
        if not denied_cols:
            continue
        parts.append(
            f"{table_name} 테이블: {', '.join(denied_cols)} 컬럼은 권한이 없습니다."
        )
    return " | ".join(parts)

def _build_row_deny_message(body, referenced: set[str]) -> str:
    """이번 SQL 이 실제 참조한 테이블에 한해 적용된 row filter 조건을 테이블별로 안내."""
    parts = [
        f"{table_name} 테이블: 조건({tp['row_filter']}) 에 해당하는 행만 조회됩니다."
        for table_name, tp in body.policy.get("tables", {}).items()
        if table_name.upper() in referenced and tp.get("row_filter")
    ]
    return " | ".join(parts)
