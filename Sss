Private Sub DuplicateForValue(ws As Worksheet, targetVal As String, scopeValues As Variant, scopeCol As Long)
    Dim r As Long, lastRow As Long
    Dim n As Long, i As Long
    
    lastRow = ws.Cells(ws.Rows.Count, "H").End(xlUp).Row
    
    ' 아래에서 위로 탐색해야 행 삽입 시 인덱스가 꼬이지 않음
    For r = lastRow To 2 Step -1
        If Trim(ws.Cells(r, "H").Value) = targetVal Then
            n = UBound(scopeValues) - LBound(scopeValues) + 1
            
            ' 원본 행 바로 아래에 n개 행 삽입
            ws.Rows(r + 1 & ":" & r + n).Insert Shift:=xlDown
            
            ' 원본 행을 복제하고 scope_1 값 채우기
            For i = 0 To n - 1
                ws.Rows(r).Copy ws.Rows(r + 1 + i)
                ws.Cells(r + 1 + i, scopeCol).Value = scopeValues(LBound(scopeValues) + i)
            Next i
        End If
    Next r
End Sub
