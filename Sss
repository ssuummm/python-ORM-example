Sub DuplicateRowsByH()
    Dim ws As Worksheet
    Dim scopeCol As Long, lastCol As Long, c As Long
    
    Set ws = ActiveSheet
    
    ' 1행에서 'scope_1' 헤더가 있는 열 찾기
    lastCol = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    scopeCol = 0
    For c = 1 To lastCol
        If Trim(ws.Cells(1, c).Value) = "scope_1" Then
            scopeCol = c
            Exit For
        End If
    Next c
    
    If scopeCol = 0 Then
        MsgBox "1행에서 'scope_1' 헤더를 찾을 수 없습니다. 헤더 위치를 확인해주세요."
        Exit Sub
    End If
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    ' 1) TB_HYPATH_SALES_ACTUAL -> 22개 복제
