def format_elapsed(seconds: float) -> str:
    """초를 '1시간 2분 3.4초' 형태로 바꾼다."""
    minutes, sec = divmod(seconds, 60)
    hours, minutes = divmod(int(minutes), 60)
    if hours:
        return f"{hours}시간 {minutes}분 {sec:.1f}초"
    if minutes:
        return f"{minutes}분 {sec:.1f}초"
    return f"{sec:.1f}초"
